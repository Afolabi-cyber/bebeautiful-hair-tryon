OPENAI_API_KEY=sk-...
# gpt-image-1.5 supports input_fidelity="high" (best face preservation). gpt-image-2 also works; the server omits that parameter for it.
OPENAI_IMAGE_MODEL=gpt-image-1.5
# low | medium | high  (high looks best, costs most)
OPENAI_IMAGE_QUALITY=high
# Result background: studio (clean light backdrop, default), white, or original (customer's own)
RESULT_BACKGROUND=studio
# Face retouch (skin, tone, light only; identity is never changed): 0 = off, 0.75 = default, 1 = strongest
FACE_ENHANCE=0.75
# Most AI try-ons one customer can generate (cost guard)
MAX_TRYONS_PER_PERSON=10
# Public limits per phone/IP per hour (abuse and cost protection)
PHOTOS_PER_IP_PER_HOUR=15
TRYONS_PER_IP_PER_HOUR=30

# Admin dashboard at /admin
ADMIN_PASSWORD=choose-a-strong-password
SECRET_KEY=any-long-random-string

# Without the hair/clothes model the outfit can't be fully protected, so try-ons pause (off).
# Only set to on if you accept that clothes may change.
ALLOW_WITHOUT_HAIR_MODEL=off
